      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırıcı 24 saat geriden 24 saat ileriye uzanır. Yalnızca RXZone’un gösterdiğini değiştirir — Mac’inizin saati asla değiştirilmez."
          }
        }
