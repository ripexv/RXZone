{
  "sourceLanguage": "en",
  "strings": {
    "%@ in %@ · %@": {
      "comment": "Banner after typing a time into a row: time, row name, offset from now",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ in %2$@ · %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ saatiyle %1$@ · %3$@"
          }
        }
      }
    },
    "%@, already added": {
      "comment": "Accessibility label",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, zaten ekli"
          }
        }
      }
    },
    "%lld days": {
      "comment": "Zone is several days behind",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gün"
          }
        }
      }
    },
    "%lldh": {
      "comment": "Hours, abbreviated: 3h",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sa"
          }
        }
      }
    },
    "%lldm": {
      "comment": "Minutes, abbreviated: 15m",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dk"
