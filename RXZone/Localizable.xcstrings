    "New time zones are added here automatically. Untick any you would rather keep in the popover only — or right-click the row in the popover.": {
      "comment": "Explains multi-zone menu bar selection",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni saat dilimleri buraya otomatik olarak eklenir. Yalnızca açılır pencerede kalmasını istediklerinizin işaretini kaldırın — ya da pencerede satıra sağ tıklayın."
          }
        }
      }
    },
    "Night there": {
      "comment": "Tooltip on the moon badge",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orada gece"
          }
        }
      }
    },
